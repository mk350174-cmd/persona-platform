# ══════════════════════════════════════════════════════════════════════════════
# Persona Platform — Staging Environment Configuration
# ══════════════════════════════════════════════════════════════════════════════
#
# This file contains environment variables for the staging environment.
# For production, create .env.production with hardened values.
# For local development, use .env or .env.example
#
# ⚠️  DO NOT COMMIT REAL SECRETS TO VERSION CONTROL
# Use `.env.staging.local` for sensitive values in CI/CD or local machines
#
# ══════════════════════════════════════════════════════════════════════════════

# ── Environment ────────────────────────────────────────────────────────────
ENVIRONMENT=staging
DEBUG=true
LOG_LEVEL=DEBUG

# ── Application ────────────────────────────────────────────────────────────
# Base URL for API (used for CORS, webhooks, and client redirects)
BASE_URL=http://localhost:8000

# Application port
PORT=8000

# ── Database (PostgreSQL) ──────────────────────────────────────────────────
# Staging database configuration (non-production credentials)
# Host resolves via Docker network 'postgres' service name
DATABASE_URL=postgresql://staging_user:staging_password_change_me@postgres:5432/persona_hub_staging

# PostgreSQL connection parameters (docker-compose passes these to Postgres)
POSTGRES_USER=staging_user
POSTGRES_PASSWORD=staging_password_change_me
POSTGRES_DB=persona_hub_staging

# Connection pool settings
# Keep lower for staging to catch connection issues early
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ── Cache (Redis) ──────────────────────────────────────────────────────────
# Redis URL for sessions, rate limiting, and caching
# Host resolves via Docker network 'redis' service name
REDIS_URL=redis://redis:6379/0

# Redis settings
REDIS_DB=0
REDIS_CACHE_TTL=3600
REDIS_SESSION_TTL=86400

# ── Security ───────────────────────────────────────────────────────────────
# Secret key for session signing (generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=staging-secret-key-change-me-in-ci-cd-or-local-machine

# CORS allowed origins (comma-separated)
# Staging allows localhost and staging domain
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000,https://staging.persona-hub.com

# Require email verification before API key is returned
REQUIRE_EMAIL_VERIFICATION=true

# Session settings
SESSION_EXPIRY_HOURS=24
MAX_LOGIN_ATTEMPTS=5
LOGIN_ATTEMPT_WINDOW_MINUTES=15

# ── API Keys & Integrations ────────────────────────────────────────────────

# Anthropic Claude API (for persona generation)
# Get from: https://console.anthropic.com/account/keys
ANTHROPIC_API_KEY=sk-ant-staging-key-change-me

# ElevenLabs (voice synthesis)
# Get from: https://elevenlabs.io/app/speech-synthesis/settings/api-keys
ELEVENLABS_API_KEY=el_staging_key_change_me

# Stripe (payments) - Use TEST keys in staging
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_staging_key_change_me
STRIPE_PUBLISHABLE_KEY=pk_test_staging_key_change_me
STRIPE_WEBHOOK_SECRET=whsec_staging_key_change_me

# Stripe Webhook signing (for payment events)
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# ── Email (Resend) ─────────────────────────────────────────────────────────
# Email API for transactional emails
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_staging_key_change_me
FROM_EMAIL=noreply-staging@persona-hub.com

# Email testing (optional: redirect all emails to a single address in staging)
TEST_EMAIL_RECIPIENT=test-staging@example.com

# ── Assets & Storage ───────────────────────────────────────────────────────
# Base URL for persona portrait assets
# Uses GitHub raw content (staging doesn't require authentication)
PERSONA_ASSETS_BASE_URL=https://raw.githubusercontent.com/mk350174-cmd/Persona-assentleri/main

# File upload settings
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_TYPES=image/jpeg,image/png,image/webp

# ── Backup & Disaster Recovery ─────────────────────────────────────────────
# Staging uses local backups only (no S3)
# Backups stored in: docker volume staging_backups
BACKUP_DIR=/backups
BACKUP_ENABLED=true
BACKUP_SCHEDULE_CRON=0 2 * * *  # Daily at 2 AM

# S3 disabled in staging to avoid costs
BACKUP_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Feature Flags ──────────────────────────────────────────────────────────
# Enable all features for testing (different from production)
FEATURE_PERSONAS_ENABLED=true
FEATURE_PERSONAS_GENERATION=true
FEATURE_VOICE_SYNTHESIS=true
FEATURE_CUSTOM_PERSONAS=true
FEATURE_PAYMENTS=true
FEATURE_SUBSCRIPTIONS=true
FEATURE_ANALYTICS=false  # Disabled to avoid polluting production analytics
FEATURE_BETA_API=true    # Enable beta endpoints for testing

# ── Analytics & Monitoring ────────────────────────────────────────────────
# Analytics disabled to avoid polluting production metrics
ANALYTICS_ENABLED=false
ANALYTICS_TRACKING_ID=

# Sentry error tracking (optional in staging)
# Get from: https://sentry.io
SENTRY_DSN=

# PostHog product analytics (optional in staging)
POSTHOG_API_KEY=

# ── Logging & Observability ───────────────────────────────────────────────
# Structured logging
LOG_FORMAT=json
LOG_TIMESTAMP=utc

# Request logging (disable for high-traffic testing to reduce log volume)
LOG_HTTP_REQUESTS=true
LOG_SQL_QUERIES=true

# Performance monitoring
ENABLE_PROFILING=false  # Set to true to enable Flask profiler
PROFILE_REQUESTS_THRESHOLD_MS=200

# ── Rate Limiting ──────────────────────────────────────────────────────────
# Per-IP rate limiting (requests per minute)
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10  # Lower for auth endpoints

# ── Monitoring & Health Checks ────────────────────────────────────────────
# Health check endpoints (used by Docker and load balancers)
HEALTH_CHECK_DATABASE=true
HEALTH_CHECK_REDIS=true
HEALTH_CHECK_EXTERNAL_APIS=false  # Set to true to check upstream APIs

# ── Testing & Development ────────────────────────────────────────────────
# Seed test data on startup
SEED_DATABASE=false

# Expose debug information in responses (careful in shared staging!)
EXPOSE_DEBUG_INFO=true

# Allow unauthenticated access to certain endpoints (for testing)
ALLOW_UNAUTHENTICATED_PERSONA_BROWSE=true

# ── Grafana Dashboards ─────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── Optional Service URLs ──────────────────────────────────────────────────
# For connecting to external services in staging
ADMINER_ENABLED=true
ADMINER_PORT=8081

PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9091

GRAFANA_ENABLED=true
GRAFANA_PORT=3001

# ══════════════════════════════════════════════════════════════════════════════
# Notes:
# ══════════════════════════════════════════════════════════════════════════════
#
# 1. Sensitive values: For CI/CD or local machines, override in .env.staging.local
#    Example: STRIPE_SECRET_KEY=sk_test_real_key_here
#
# 2. Database migrations: Automatic on container startup via Alembic
#    To manually migrate: docker-compose exec api alembic upgrade head
#
# 3. Database reset: docker-compose down -v && docker-compose up -d
#    (Removes all named volumes and recreates fresh database)
#
# 4. Accessing services from host:
#    - API: http://localhost:8000
#    - Database: psql postgresql://staging_user:staging_password_change_me@localhost:5433/persona_hub_staging
#    - Redis: redis-cli -p 6380
#    - Adminer: http://localhost:8081
#    - Prometheus: http://localhost:9091
#    - Grafana: http://localhost:3001 (admin / admin)
#
# 5. Testing: Run tests against staging with:
#    pytest tests/ --env=staging --cov
#
# ══════════════════════════════════════════════════════════════════════════════
