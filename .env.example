# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── ElevenLabs (voice synthesis) ─────────────────────────────────────────────
ELEVENLABS_API_KEY=el_...

# ── Stripe (payments) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App ───────────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./persona.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Use * only for local dev.
CORS_ORIGINS=http://localhost:8000,https://yourdomain.com

# ── Persona portrait assets (external repo) ───────────────────────────────────
# Raw base URL for persona portrait images. When set, image_url always points
# to this repo — frontend handles missing images via onerror fallback.
# Leave empty to fall back to local demo/assets/personas/ files.
PERSONA_ASSETS_BASE_URL=https://raw.githubusercontent.com/mk350174-cmd/Persona-assentleri/main

# ── Optional overrides ────────────────────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/persona
# PORT=8000
