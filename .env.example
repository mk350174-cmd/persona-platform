# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── ElevenLabs (voice synthesis) ─────────────────────────────────────────────
ELEVENLABS_API_KEY=el_...

# ── Stripe (payments) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App ───────────────────────────────────────────────────────────────────────
BASE_URL=http://localhost:8000
DATABASE_URL=sqlite:///./persona.db

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Use * only for local dev.
CORS_ORIGINS=http://localhost:8000,https://yourdomain.com

# ── Persona portrait assets (external repo) ───────────────────────────────────
# Raw base URL for persona portrait images. When set, image_url always points
# to this repo — frontend handles missing images via onerror fallback.
# Leave empty to fall back to local demo/assets/personas/ files.
PERSONA_ASSETS_BASE_URL=https://raw.githubusercontent.com/mk350174-cmd/Persona-assentleri/main

# ── Email (Resend — https://resend.com, free tier: 3000/month) ─────────────────
# RESEND_API_KEY=re_...
# FROM_EMAIL=noreply@yourdomain.com

# ── Security ──────────────────────────────────────────────────────────────────
# Set to "true" to require email verification before API key is returned.
# Default: false (key returned on registration, verification email still sent).
REQUIRE_EMAIL_VERIFICATION=false

# ── Database (PostgreSQL for production) ──────────────────────────────────────
# Set to PostgreSQL URL for production. Default: SQLite for development.
# DATABASE_URL=postgresql://persona:persona_dev_password@postgres:5432/persona_hub
# POSTGRES_USER=persona
# POSTGRES_PASSWORD=persona_dev_password

# ── Backup & Disaster Recovery (AWS S3) ────────────────────────────────────────
# S3 bucket for automated backups. Leave empty to skip S3 uploads (local backup only).
# BACKUP_S3_BUCKET=persona-backups-prod
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# ── Optional overrides ────────────────────────────────────────────────────────
# PORT=8000
